      margin: 0;
      font-size: 0.96rem;
    }

    .tag-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }

    .tag {
      padding: 8px 12px;
      border-radius: 999px;
      background: #f3f7fd;
      border: 1px solid #dbe7f5;
      color: #274869;
      font-size: 0.86rem;
      font-weight: 600;
    }

    .project {
      padding: 22px 0;
      border-top: 1px solid var(--line);
    }

    .project:first-of-type {
      border-top: 0;
      padding-top: 0;
    }

    .project-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: start;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }

    .project h3 {
      margin: 0;
      font-size: 1.18rem;
      line-height: 1.35;
    }

    .project-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .pill {
      padding: 6px 10px;
      border-radius: 999px;
      background: #eef5fb;
      color: #24527d;
      font-size: 0.76rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .project p {
      margin: 10px 0 0;
    }

    .project ul {
      margin: 12px 0 0 18px;
      padding: 0;
      color: var(--muted);
    }

    .project li {
      margin-bottom: 8px;
    }

    .reasoning {
      display: grid;
      gap: 16px;
    }

    .reasoning-box {
      padding: 18px 20px;
      border-radius: 20px;
      background: #fbfcff;
      border: 1px dashed #cddaf0;
    }

    .reasoning-box h3 {
      margin: 0 0 8px;
      font-size: 1.02rem;
    }

    .timeline {
