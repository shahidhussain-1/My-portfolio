      margin: 0 0 10px;
    }

    @media (max-width: 980px) {
      .hero-grid,
      .grid,
      .two-col {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 34px 24px;
      }

      .page {
        width: min(100% - 18px, 1160px);
        margin: 10px auto 30px;
      }
    }

    @media print {
      body {
        background: white;
      }
      .page {
        width: 100%;
        margin: 0;
      }
      .hero,
      .card,
      .footer-note {
        box-shadow: none;
      }
      .btn {
        display: none;
      }
    }
  </style>
</head>
