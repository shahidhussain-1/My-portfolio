      border-radius: 20px;
      background: #fafcff;
      border: 1px solid #e7edf7;
    }

    .role-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 8px;
