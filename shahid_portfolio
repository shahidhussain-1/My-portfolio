  <style>
    :root {
      --bg: #f7f8fb;
      --paper: #ffffff;
      --ink: #121826;
      --muted: #566177;
      --line: #e6eaf2;
      --soft: #f3f6fc;
      --brand: #0f4c81;
      --brand-2: #123456;
      --accent: #dbe9f8;
      --success: #edf7ef;
      --shadow: 0 18px 50px rgba(17, 24, 39, 0.08);
      --radius: 22px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: linear-gradient(180deg, #eef4fb 0%, #f8f9fc 30%, #f7f8fb 100%);
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      line-height: 1.65;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      width: min(1160px, calc(100% - 32px));
      margin: 32px auto 56px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at top right, rgba(78, 150, 220, 0.24), transparent 34%),
                  linear-gradient(135deg, #0b2f52 0%, #114b7d 48%, #14395f 100%);
      color: white;
      border-radius: 30px;
      padding: 46px 42px;
      box-shadow: 0 24px 60px rgba(13, 58, 99, 0.22);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.7fr 1fr;
      gap: 28px;
      align-items: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.16);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero h1 {
      margin: 18px 0 10px;
      font-family: 'Playfair Display', serif;
      font-size: clamp(2.6rem, 7vw, 4.7rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .hero-role {
      margin: 0 0 18px;
      font-size: 1.02rem;
      font-weight: 600;
      color: #dcecff;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .hero p {
      margin: 0;
      max-width: 760px;
      color: rgba(255,255,255,0.88);
      font-size: 1.04rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 999px;
      font-weight: 600;
      border: 1px solid transparent;
      transition: 0.25s ease;
    }

    .btn-primary {
      background: white;
      color: var(--brand-2);
    }

    .btn-secondary {
      border-color: rgba(255,255,255,0.28);
      color: white;
      background: rgba(255,255,255,0.06);
    }

    .contact-card {
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 24px;
      padding: 22px 22px 18px;
      backdrop-filter: blur(10px);
    }

    .contact-card h3 {
      margin: 0 0 14px;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #dcecff;
    }

    .contact-list {
      display: grid;
      gap: 12px;
      font-size: 0.97rem;
    }

    .contact-item span {
      display: block;
      font-size: 0.73rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(255,255,255,0.62);
      margin-bottom: 3px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1.35fr 0.95fr;
      gap: 24px;
      margin-top: 26px;
    }

    .stack {
      display: grid;
      gap: 24px;
    }

    .card {
      background: rgba(255,255,255,0.92);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow);
    }

    .section-label {
      display: inline-flex;
      margin-bottom: 10px;
      color: var(--brand);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    .card h2 {
      margin: 0 0 14px;
      font-size: 1.55rem;
      line-height: 1.15;
      letter-spacing: -0.03em;
